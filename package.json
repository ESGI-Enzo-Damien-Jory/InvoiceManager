{
    "name": "invoice-manager",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10.0.0",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format:check": "turbo run format:check",
        "format:apply": "turbo run format:apply",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "test:ci": "turbo run test:ci",
        "test:ci:unit": "turbo run test:ci:unit",
        "test:ci:e2e": "turbo run test:ci:e2e"
    },
    "devDependencies": {
        "eslint": "^9.24.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.0",
        "prettier": "^3.5.3",
        "turbo": "^2.5.0"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "pnpm": {
        "overrides": {
            "pdfjs-dist@<=4.1.392": ">=4.2.67",
            "brace-expansion@>=1.0.0 <=1.1.11": ">=1.1.12",
            "brace-expansion@>=2.0.0 <=2.0.1": ">=2.0.2"
        }
    }
}
